<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".F1App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.F1Live">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- specialUse, not dataSync: Android 15 caps dataSync at 6 h a day, which a delayed race can hit. -->
        <service
            android:name=".live.LiveUpdateService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live sports scores: an ongoing Live Update notification with the timing of an F1 session the user chose to follow, shown only while that session runs." />
        </service>

        <receiver
            android:name=".live.AutoFollowReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget -->
        <receiver
            android:name=".widget.NextSessionWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_f1_live_info" />
            <meta-data
                android:name="com.sec.android.appwidget.widgetinfo"
                android:resource="@xml/widget_supported_cell_size_info" />
            <meta-data
                android:name="android.appwidget.provider.semConfigureActivity"
                android:value="com.flexy.f1live.widget.WidgetConfigActivity" />
        </receiver>

        <!-- Standings widgets -->
        <receiver
            android:name=".widget.standings.DriverStandingsWidgetReceiver"
            android:exported="true"
            android:label="@string/standings_widget_drivers_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_driver_standings_info" />
            <meta-data
                android:name="com.sec.android.appwidget.widgetinfo"
                android:resource="@xml/widget_standings_cell_size_info" />
            <meta-data
                android:name="android.appwidget.provider.semConfigureActivity"
                android:value="com.flexy.f1live.widget.WidgetConfigActivity" />
        </receiver>

        <receiver
            android:name=".widget.standings.TeamStandingsWidgetReceiver"
            android:exported="true"
            android:label="@string/standings_widget_teams_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_team_standings_info" />
            <meta-data
                android:name="com.sec.android.appwidget.widgetinfo"
                android:resource="@xml/widget_standings_cell_size_info" />
            <meta-data
                android:name="android.appwidget.provider.semConfigureActivity"
                android:value="com.flexy.f1live.widget.WidgetConfigActivity" />
        </receiver>

        <receiver
            android:name=".widget.standings.TitleFightWidgetReceiver"
            android:exported="true"
            android:label="@string/title_fight_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_title_fight_info" />
            <meta-data
                android:name="com.sec.android.appwidget.widgetinfo"
                android:resource="@xml/widget_standings_cell_size_info" />
            <meta-data
                android:name="android.appwidget.provider.semConfigureActivity"
                android:value="com.flexy.f1live.widget.WidgetConfigActivity" />
        </receiver>

        <!-- Widget settings -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:taskAffinity=""
            android:theme="@style/Theme.F1Live">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Samsung lock-screen widget, 2x1 -->
        <receiver
            android:name=".widget.lock.SamsungLockWidgetReceiver"
            android:exported="true"
            android:label="@string/lock_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_2x1_info" />
            <meta-data
                android:name="samsung.appwidget.monotone.info"
                android:resource="@xml/lock_2x1_info_oneui" />
        </receiver>

        <!-- Legacy Samsung lock-screen ServiceBox -->
        <receiver
            android:name=".widget.lock.SamsungLockServiceBoxReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.samsung.android.intent.action.REQUEST_SERVICEBOX_REMOTEVIEWS" />
            </intent-filter>
        </receiver>

        <!-- Samsung lock-screen widget, 2x2: enabled at run time on tablets and foldables only -->
        <receiver
            android:name=".widget.lock.SamsungLockWidgetLargeReceiver"
            android:enabled="false"
            android:exported="true"
            android:label="@string/lock_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_2x2_info" />
            <meta-data
                android:name="samsung.appwidget.monotone.info"
                android:resource="@xml/lock_2x2_info_oneui" />
        </receiver>

        <!-- Samsung lock-screen standings widgets, 2x2: enabled at run time on tablets and foldables only -->
        <receiver
            android:name=".widget.lock.DriverStandingsLockWidgetReceiver"
            android:enabled="false"
            android:exported="true"
            android:label="@string/lock_standings_drivers_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_driver_standings_info" />
            <meta-data
                android:name="samsung.appwidget.monotone.info"
                android:resource="@xml/lock_driver_standings_info_oneui" />
        </receiver>

        <receiver
            android:name=".widget.lock.TeamStandingsLockWidgetReceiver"
            android:enabled="false"
            android:exported="true"
            android:label="@string/lock_standings_teams_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_team_standings_info" />
            <meta-data
                android:name="samsung.appwidget.monotone.info"
                android:resource="@xml/lock_team_standings_info_oneui" />
        </receiver>

        <receiver
            android:name=".widget.lock.TitleFightLockWidgetReceiver"
            android:enabled="false"
            android:exported="true"
            android:label="@string/lock_title_fight_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_title_fight_info" />
            <meta-data
                android:name="samsung.appwidget.monotone.info"
                android:resource="@xml/lock_title_fight_info_oneui" />
        </receiver>
    </application>
</manifest>
