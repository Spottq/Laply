<?xml version="1.0" encoding="utf-8"?>
<!-- The standings widgets' dashed title line (widget/standings): a white line, tinted at runtime
     with the text colour. Dashes as in the app's TitleCutLine, 4 dp on, 3 dp off. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="line">
    <stroke
        android:width="1dp"
        android:color="@android:color/white"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <size android:height="2dp" />
</shape>
