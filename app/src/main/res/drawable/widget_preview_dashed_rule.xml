<?xml version="1.0" encoding="utf-8"?>
<!-- widget_dashed_rule for the static picker previews, which cannot tint at runtime. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="line">
    <stroke
        android:width="1dp"
        android:color="@color/widget_on_surface_variant"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <size android:height="2dp" />
</shape>
