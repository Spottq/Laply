     lock-screen widget in lock_2x1_info.xml: the small (2x1) slot only - the 2x2 "medium" slot
     belongs to the separate 2x2 lock widget (lock_2x2_info.xml).
     Adapted from twidget (MIT, © 2026 Josh Skinner), res/xml/lockscreen_message_2x1_widget_info_oneui.xml. -->
<samsung-appwidget-info xmlns:app="http://schemas.android.com/apk/res-auto"
    app:allowMultipleSizes="true"
    app:initialLayoutMedium="@layout/widget_lock_2x1"
    app:initialLayoutSmall="@layout/widget_lock_2x1"
    app:previewLayoutMedium="@layout/widget_lock_2x1"
    app:previewLayoutSmall="@layout/widget_lock_2x1"
    app:targetHost="lock_and_aod|cover"
    app:widgetSize="small" />
