<?xml version="1.0" encoding="utf-8"?>
<!-- widgetCategory 0x2000 is Samsung's lock-screen category. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/lock_standings_teams_description"
    android:initialKeyguardLayout="@layout/widget_lock_standings_teams"
    android:initialLayout="@layout/widget_lock_standings_teams"
    android:minWidth="124dp"
    android:minHeight="124dp"
    android:minResizeWidth="118dp"
    android:minResizeHeight="124dp"
    android:previewLayout="@layout/widget_lock_standings_teams"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="0x2000"
    app:initialLayoutLarge="@layout/widget_lock_standings_teams"
    app:initialLayoutMedium="@layout/widget_lock_standings_teams"
    app:lockWidgetSize="medium|large"
    app:monotoneInitialLayoutLarge="@layout/widget_lock_standings_teams"
    app:monotoneInitialLayoutMedium="@layout/widget_lock_standings_teams"
    app:monotonePreviewLayoutLarge="@layout/widget_lock_standings_teams"
    app:monotonePreviewLayoutMedium="@layout/widget_lock_standings_teams"
    app:previewLayoutLarge="@layout/widget_lock_standings_teams"
    app:previewLayoutMedium="@layout/widget_lock_standings_teams"
    app:previewSize="medium"
    app:targetHost="lock_and_aod"
    app:widgetSize="medium|large"
    app:widgetStyle="monotone"
    tools:ignore="UnusedAttribute" />
