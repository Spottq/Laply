<?xml version="1.0" encoding="utf-8"?>
<!--
    Samsung One UI lock screen / AOD widget, 2x2 (tablets and foldables): overline, Grand Prix,
    next session, countdown and the two sessions after it. widgetCategory 0x2000 is Samsung's
    lock-screen category (stock launchers never list it). On the lock screen Samsung's 2x2 slot is
    the "medium" size (Samsung Notes' 2x2 lock widget: widgetSize = lockWidgetSize = medium,
    targetCell 2x2, ~118 x 131 dp); the user's LockWidgets project declares its 2x2 as "large",
    so both are declared, with the same layout. The receiver ships disabled and is switched on at
    run time on sw600dp / hinge devices only (SamsungLockWidgetLarge.syncEnabled), as LockWidgets
    does, so phones never offer it.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/lock_large_description"
    android:initialKeyguardLayout="@layout/widget_lock_2x2"
    android:initialLayout="@layout/widget_lock_2x2"
    android:minWidth="124dp"
    android:minHeight="124dp"
    android:minResizeWidth="118dp"
    android:minResizeHeight="124dp"
    android:previewLayout="@layout/widget_lock_2x2"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="0x2000"
    app:initialLayoutLarge="@layout/widget_lock_2x2"
    app:initialLayoutMedium="@layout/widget_lock_2x2"
    app:lockWidgetSize="medium|large"
    app:monotoneInitialLayoutLarge="@layout/widget_lock_2x2"
    app:monotoneInitialLayoutMedium="@layout/widget_lock_2x2"
    app:monotonePreviewLayoutLarge="@layout/widget_lock_2x2"
    app:monotonePreviewLayoutMedium="@layout/widget_lock_2x2"
    app:previewLayoutLarge="@layout/widget_lock_2x2"
    app:previewLayoutMedium="@layout/widget_lock_2x2"
    app:previewSize="medium"
    app:targetHost="lock_and_aod"
    app:widgetSize="medium|large"
    app:widgetStyle="monotone"
    tools:ignore="UnusedAttribute" />
