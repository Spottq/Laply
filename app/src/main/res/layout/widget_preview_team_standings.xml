<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview of the constructors' standings widget for launchers before Android 15 (15+ gets one
     generated from the real widget, widget/standings). Made-up table. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/standings_widget_preview_teams"
            android:textAllCaps="true"
            android:textColor="@color/widget_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/standings_widget_preview_teams_detail"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="8dp"
            android:background="#F47600" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="McLaren"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="626"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="2"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="8dp"
            android:background="#E8002D" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Ferrari"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="470"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="3"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="8dp"
            android:background="#27F4D2" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Mercedes"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="455"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_dashed_rule" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:text="@string/standings_widget_out_of_reach"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="10sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_dashed_rule" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="4"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="8dp"
            android:background="#3671C6" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Red Bull"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="268"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
