<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lock_standings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical|start"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/lock_fight_overline"
            style="@style/LockStandingsOverline"
            android:text="LEADER · R20" />

        <TextView
            android:id="@+id/lock_fight_name"
            style="@style/LockStandingsText"
            android:layout_width="match_parent"
            android:layout_marginTop="3dp"
            android:text="Piastri"
            android:textFontWeight="600"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/lock_fight_points_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lock_fight_points"
                style="@style/LockStandingsText"
                android:layout_width="wrap_content"
                android:text="324"
                android:textFontWeight="700"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/lock_fight_pts"
                style="@style/LockStandingsText"
                android:layout_width="wrap_content"
                android:layout_marginStart="3dp"
                android:alpha="0.72"
                android:text="@string/standings_widget_pts"
                android:textFontWeight="600"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lock_fight_gaps"
            style="@style/LockStandingsText"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:alpha="0.72"
            android:text="NOR −22 · VER −83"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/lock_fight_detail"
            style="@style/LockStandingsText"
            android:layout_width="match_parent"
            android:layout_marginTop="2dp"
            android:alpha="0.72"
            android:text="108 pts to play for"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
