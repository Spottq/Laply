<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lock_standings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical|start"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/lock_standings_overline"
            style="@style/LockStandingsOverline"
            android:text="DRIVERS · R20" />

        <LinearLayout
            android:id="@+id/lock_standings_row1"
            style="@style/LockStandingsRow">

            <TextView
                android:id="@+id/lock_standings_position1"
                style="@style/LockStandingsPosition"
                android:text="1" />

            <TextView
                android:id="@+id/lock_standings_name1"
                style="@style/LockStandingsName"
                android:text="PIA" />

            <TextView
                android:id="@+id/lock_standings_points1"
                style="@style/LockStandingsPoints"
                android:text="324" />
        </LinearLayout>

        <TextView
            android:id="@+id/lock_standings_line1"
            style="@style/LockStandingsLine" />

        <LinearLayout
            android:id="@+id/lock_standings_row2"
            style="@style/LockStandingsRow">

            <TextView
                android:id="@+id/lock_standings_position2"
                style="@style/LockStandingsPosition"
                android:text="2" />

            <TextView
                android:id="@+id/lock_standings_name2"
                style="@style/LockStandingsName"
                android:text="NOR" />

            <TextView
                android:id="@+id/lock_standings_points2"
                style="@style/LockStandingsPoints"
                android:text="302" />
        </LinearLayout>

        <TextView
            android:id="@+id/lock_standings_line2"
            style="@style/LockStandingsLine" />

        <LinearLayout
            android:id="@+id/lock_standings_row3"
            style="@style/LockStandingsRow">

            <TextView
                android:id="@+id/lock_standings_position3"
                style="@style/LockStandingsPosition"
                android:text="3" />

            <TextView
                android:id="@+id/lock_standings_name3"
                style="@style/LockStandingsName"
                android:text="VER" />

            <TextView
                android:id="@+id/lock_standings_points3"
                style="@style/LockStandingsPoints"
                android:text="241" />
        </LinearLayout>

        <TextView
            android:id="@+id/lock_standings_line3"
            style="@style/LockStandingsLine"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/lock_standings_row4"
            style="@style/LockStandingsRow">

            <TextView
                android:id="@+id/lock_standings_position4"
                style="@style/LockStandingsPosition"
                android:text="4" />

            <TextView
                android:id="@+id/lock_standings_name4"
                style="@style/LockStandingsName"
                android:text="RUS" />

            <TextView
                android:id="@+id/lock_standings_points4"
                style="@style/LockStandingsPoints"
                android:text="198" />
        </LinearLayout>

        <TextView
            android:id="@+id/lock_standings_line4"
            style="@style/LockStandingsLine" />

        <LinearLayout
            android:id="@+id/lock_standings_row5"
            style="@style/LockStandingsRow">

            <TextView
                android:id="@+id/lock_standings_position5"
                style="@style/LockStandingsPosition"
                android:text="5" />

            <TextView
                android:id="@+id/lock_standings_name5"
                style="@style/LockStandingsName"
                android:text="LEC" />

            <TextView
                android:id="@+id/lock_standings_points5"
                style="@style/LockStandingsPoints"
                android:text="181" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
